# Copy to .env.local and fill in. See docs/deployment.md for what each variable does.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin; https://www.nicemodels.ch in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the scheduled jobs (x-cron-secret header)
CRON_SECRET=

# Transactional email (Resend). Email is skipped while RESEND_API_KEY is empty.
RESEND_API_KEY=
EMAIL_FROM="NiceModels <noreply@nicemodels.ch>"
EMAIL_REPLY_TO=info@nicemodels.ch
EMAIL_UNSUB_SECRET=

# Contact form (EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Free promotional periods: set to false to charge again
NEXT_PUBLIC_MODEL_SEDCARD_FREE=
NEXT_PUBLIC_CLUB_AD_FREE=

# Blog CMS
CMS_BASE_URL=
CMS_SITE_ID=

# Search console verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
